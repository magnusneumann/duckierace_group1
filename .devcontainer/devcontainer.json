{
    "name": "DuckieRace Dev Environment",
    "build": {
        "dockerfile": "Dockerfile"
    },
    "runArgs": [
        "--net=host",
        "--privileged",
        "-v", "/tmp/.X11-unix:/tmp/.X11-unix",
        "-v", "/var/run/dbus:/var/run/dbus",
        "-v", "/var/run/avahi-daemon/socket:/var/run/avahi-daemon/socket"
    ],
    "containerUser": "root",
    "remoteUser": "root",
    "workspaceMount": "source=${localWorkspaceFolder},target=/root/DuckieRace,type=bind",
    "workspaceFolder": "/root/DuckieRace",
    "customizations": {
        "vscode": {
            "extensions": [
                "ms-iot.vscode-ros",
                "ms-python.python",
                "ms-vscode.cpptools"
            ]
        }
    },
    // postCreateCommand wird jetzt nur noch für Dinge genutzt, 
    // die den Workspace selbst betreffen, z.B. Abhängigkeiten installieren
    "postCreateCommand": "rosdep update && rosdep install --from-paths src --ignore-src -r -y",
    "shutdownAction": "stopContainer" 
}